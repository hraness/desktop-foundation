{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hraness/desktop-foundation/contract/envelope.schema.json",
  "title": "Hraness CLI JSON envelope",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "schema", "generatedAt", "data"],
      "properties": {
        "ok": { "const": true },
        "schema": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}(\\.[a-z0-9][a-z0-9-]{0,31})+/[0-9]{1,9}$" },
        "generatedAt": { "$ref": "#/$defs/timestamp" },
        "data": {},
        "next": { "$ref": "#/$defs/next" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "schema", "generatedAt", "error"],
      "properties": {
        "ok": { "const": false },
        "schema": { "const": "hraness.error/1" },
        "generatedAt": { "$ref": "#/$defs/timestamp" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "pattern": "^([a-z][a-z0-9-]*|[a-z][a-z0-9-]{0,31}\\.[a-z0-9][a-z0-9.-]{0,63})$" },
            "message": { "type": "string", "minLength": 1 },
            "detail": { "type": "string" },
            "next": { "$ref": "#/$defs/next" }
          }
        }
      }
    }
  ],
  "$defs": {
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "next": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "why", "audience"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "audience": { "enum": ["agent", "human"] }
        }
      }
    }
  }
}
