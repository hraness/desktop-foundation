{
  "name": "@hraness/desktop-foundation",
  "version": "2.0.0",
  "description": "The one-shot desktop helper, control kit and CLI contract that Hraness CLI tools share on macOS, Windows, and Linux, with no app bundle or installer.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/hraness/desktop-foundation.git" },
  "engines": { "node": ">=22" },
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" },
    "./permissions": { "types": "./dist/src/permissions.d.ts", "import": "./dist/src/permissions.js" },
    "./audience": { "types": "./dist/src/audience.d.ts", "import": "./dist/src/audience.js" },
    "./cli-style": { "types": "./dist/src/cli-style.d.ts", "import": "./dist/src/cli-style.js" },
    "./registry": { "types": "./dist/src/registry.d.ts", "import": "./dist/src/registry.js" },
    "./control": { "types": "./dist/src/control.d.ts", "import": "./dist/src/control.js" },
    "./human-gate": { "types": "./dist/src/human-gate.d.ts", "import": "./dist/src/human-gate.js" },
    "./login": { "types": "./dist/src/login.d.ts", "import": "./dist/src/login.js" },
    "./retire": { "types": "./dist/src/retire.d.ts", "import": "./dist/src/retire.js" },
    "./helper": { "types": "./dist/src/helper.d.ts", "import": "./dist/src/helper.js" }
  },
  "files": ["dist/src", "src", "crates/hraness-control-kit/src", "crates/hraness-local-app/src", "release-manifest.json", "contract", "README.md", "docs", "skills", "LICENSE"],
  "scripts": {
    "build:sdk": "tsc -p sdk/tsconfig.json",
    "test:sdk": "node scripts/test-sdk.mjs",
    "check:sdk": "npm run build:sdk && npm run test:sdk",
    "check": "npm run check:sdk && cargo test --locked --release && cargo build --locked --release --bin hraness-companion --bin hraness-helper"
  },
  "devDependencies": { "@types/node": "22.19.7", "typescript": "7.0.2" }
}
