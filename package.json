{
  "name": "@hraness/desktop-foundation",
  "version": "0.7.0",
  "description": "Menu bar and tray companions that CLI tools launch themselves on macOS, Windows, and Linux, with no app bundle or installer.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/hraness/desktop-foundation.git" },
  "engines": { "node": ">=22" },
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" },
    "./permissions": { "types": "./dist/src/permissions.d.ts", "import": "./dist/src/permissions.js" },
    "./audience": { "types": "./dist/src/audience.d.ts", "import": "./dist/src/audience.js" },
    "./cli-style": { "types": "./dist/src/cli-style.d.ts", "import": "./dist/src/cli-style.js" }
  },
  "bin": { "companion": "./dist/src/cli.js" },
  "files": ["dist/src", "src", "sdk/src/protocol.ts", "sdk/src/client.ts", "sdk/src/commands.ts", "sdk/src/prompt.ts", "release-manifest.json", "README.md", "docs", "skills", "LICENSE"],
  "scripts": {
    "build:sdk": "tsc -p sdk/tsconfig.json",
    "test:sdk": "node scripts/test-sdk.mjs",
    "check:sdk": "npm run build:sdk && npm run test:sdk",
    "check": "npm run check:sdk && cargo test --locked && cargo build --locked --release --bin hraness-companion"
  },
  "devDependencies": { "@types/node": "22.19.7", "typescript": "5.9.3" }
}
